{%- comment -%} Announcement bar. Default text = real shipping/returns info from the store FAQ. {%- endcomment -%}
{% if section.settings.text != blank %}<div class="dx-home"><div class="dx-ann" role="region" aria-label="Announcement">{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{% else %}{{ section.settings.text }}{% endif %}</div></div>{% endif %}
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name": "Dextor announcement", "tag": "section", "settings": [{"type": "text", "id": "text", "label": "Text", "default": "Free standard shipping over $50 · 30-day returns on unused products"}, {"type": "url", "id": "link", "label": "Link (optional)"}], "presets": [{"name": "Dextor announcement"}]}
{% endschema %}
