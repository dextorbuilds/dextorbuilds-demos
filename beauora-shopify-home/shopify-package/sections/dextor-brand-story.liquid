{%- comment -%} Brand story with photo (image picker, fallback bundled stock). {%- endcomment -%}
<section class="dx-home dx-story" id="story" aria-labelledby="bs-{{ section.id }}"><div class="dx-wrap"><figure class="dx-sfig">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.heading }}{% else %}<img src="{{ 'story-blush.webp' | asset_url }}" alt="" loading="lazy">{% endif %}{% if section.settings.stock_label != blank %}<figcaption>{{ section.settings.stock_label }}</figcaption>{% endif %}</figure><div><p class="dx-eyebrow">{{ section.settings.eyebrow }}</p><h2 id="bs-{{ section.id }}">{{ section.settings.heading }}</h2><div class="dx-rte">{{ section.settings.text }}</div>{% if section.settings.quote != blank %}<blockquote>{{ section.settings.quote }}</blockquote>{% endif %}<ul class="dx-tags">{% for t in section.settings.tags | split: ',' %}<li>{{ t | strip }}</li>{% endfor %}</ul></div></div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name": "Dextor brand story", "tag": "section", "settings": [{"type": "image_picker", "id": "image", "label": "Photo"}, {"type": "text", "id": "stock_label", "label": "Photo label", "default": "Representative stock photo (Pexels), not Beauora"}, {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Beauty that gets you."}, {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Beauora started with a simple idea: you shouldn't need a 12-step routine to look good. Three products. One look. Done.</p><p>We make vegan, cruelty-free makeup that works as hard as you do. Our Matte Lip Stain stays put through coffee, lunch, and everything after. Our Hydrating Lip Oil gives you glass lips without the stick. Our Liquid Blush gives you a flush that looks like you — not makeup.</p>"}, {"type": "text", "id": "quote", "label": "Quote", "default": "No fillers. No fluff. Just products that do what they say."}, {"type": "text", "id": "tags", "label": "Tags (comma separated)", "default": "vegan, cruelty-free, made in north america"}], "presets": [{"name": "Dextor brand story"}]}
{% endschema %}
