{%- comment -%} Dextor: brand story (dark) {%- endcomment -%}
<section class="dx-home dx-story" id="story" aria-labelledby="bs-{{ section.id }}"><div class="dx-wrap"><div>
<p class="dx-eyebrow">{{ section.settings.eyebrow }}</p><h2 id="bs-{{ section.id }}">{{ section.settings.heading }}</h2>{{ section.settings.text }}</div>
<div>{% if section.settings.quote != blank %}<blockquote>{{ section.settings.quote }}</blockquote>{% endif %}
{% if section.settings.tags != blank %}<ul class="dx-tags">{% assign tg = section.settings.tags | split: ',' %}{% for t in tg %}<li>{{ t | strip }}</li>{% endfor %}</ul>{% endif %}</div></div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name":"Dextor brand story","tag":"section","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"About"},
{"type":"text","id":"heading","label":"Heading","default":"Beauty that gets you."},
{"type":"richtext","id":"text","label":"Text","default":"<p>Beauora started with a simple idea: you shouldn't need a 12-step routine to look good. Three products. One look. Done.</p><p>We make vegan, cruelty-free makeup that works as hard as you do. Our Matte Lip Stain stays put through coffee, lunch, and everything after. Our Hydrating Lip Oil gives you glass lips without the stick. Our Liquid Blush gives you a flush that looks like you — not makeup.</p>"},
{"type":"text","id":"quote","label":"Quote","default":"No fillers. No fluff. Just products that do what they say."},
{"type":"text","id":"tags","label":"Tags (comma separated)","default":"vegan, cruelty-free, made in north america"}],
"presets":[{"name":"Dextor brand story"}]}
{% endschema %}
