{%- comment -%} Reusable CTA band with background photo. Add it as many times as you like. {%- endcomment -%}
<section class="dx-home dx-band{% if section.settings.dark %} dx-band2{% endif %}" style="--bg:url({% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 }}{% else %}{{ section.settings.fallback | asset_url }}{% endif %})"><div class="dx-wrap"><p class="dx-eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><a class="dx-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{% if section.settings.micro != blank %}<p class="dx-micro">{{ section.settings.micro }}</p>{% endif %}{% if section.settings.stock_label != blank %}<p class="dx-cap">{{ section.settings.stock_label }}</p>{% endif %}</div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name": "Dextor CTA band", "tag": "section", "settings": [{"type": "image_picker", "id": "image", "label": "Background photo"}, {"type": "select", "id": "fallback", "label": "Bundled fallback", "default": "flatlay-pink.webp", "options": [{"value": "flatlay-pink.webp", "label": "Pink flat lay"}, {"value": "gloss-dark.webp", "label": "Pink gloss (dark)"}]}, {"type": "checkbox", "id": "dark", "label": "Dark style", "default": false}, {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Three products. One look. Done."}, {"type": "text", "id": "heading", "label": "Heading", "default": "Ready for your one look?"}, {"type": "text", "id": "button_label", "label": "Button label", "default": "Shop the routine"}, {"type": "url", "id": "button_link", "label": "Button link"}, {"type": "text", "id": "micro", "label": "Reassurance line", "default": "Standard shipping $9.99, free over $50 · 30-day returns on unused products"}, {"type": "text", "id": "stock_label", "label": "Photo label", "default": "Representative stock photo (Pexels), not Beauora"}], "presets": [{"name": "Dextor CTA band"}]}
{% endschema %}
