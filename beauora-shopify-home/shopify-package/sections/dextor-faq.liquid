{%- comment -%} Dextor: FAQ accordion (real questions only) {%- endcomment -%}
<section class="dx-home dx-sec" id="faq" aria-labelledby="fq-{{ section.id }}"><div class="dx-wrap dx-center"><p class="dx-eyebrow">{{ section.settings.eyebrow }}</p><h2 id="fq-{{ section.id }}">{{ section.settings.heading }}</h2></div>
<div class="dx-wrap"><div class="dx-faq">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><p>{{ block.settings.answer }}</p></details>{% endfor %}</div></div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name":"Dextor FAQ","tag":"section","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FAQ"},{"type":"text","id":"heading","label":"Heading","default":"Questions? Answered."}],
"blocks":[{"type":"faq","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Question"},{"type":"textarea","id":"answer","label":"Answer","default":"Answer"}]}],
"presets":[{"name":"Dextor FAQ","blocks":[{"type":"faq","settings":{"question":"Are your products vegan and cruelty-free?","answer":"Yes. All Beauora products are vegan, cruelty-free, and made in North America."}},{"type":"faq","settings":{"question":"How long does the Lip Stain last?","answer":"The Matte Lip Stain is designed to stay put through eating and drinking. Apply once in the morning."}},{"type":"faq","settings":{"question":"Is the Lip Oil sticky?","answer":"No. It's a hydrating formula that gives shine without the tacky feeling."}},{"type":"faq","settings":{"question":"How do I use GLOW10?","answer":"Enter GLOW10 at checkout for 10% off your order."}},{"type":"faq","settings":{"question":"How long does shipping take?","answer":"Standard: 8-14 business days ($9.99, free over $50). Express: 7-12 business days ($29.99)."}},{"type":"faq","settings":{"question":"What's your return policy?","answer":"30 days from delivery for unused products. Email hello@beauora.co to start a return."}}]}]}
{% endschema %}
