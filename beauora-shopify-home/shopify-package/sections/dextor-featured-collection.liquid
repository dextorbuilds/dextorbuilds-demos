{%- comment -%} Dextor: featured collection, exactly 3 products chosen with product pickers. {%- endcomment -%}
<section class="dx-home dx-sec" id="routine" aria-labelledby="fc-{{ section.id }}"><div class="dx-wrap">
{% if section.settings.eyebrow != blank %}<p class="dx-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
<h2 id="fc-{{ section.id }}">{{ section.settings.heading }}</h2><p class="dx-sub">{{ section.settings.subheading }}</p>
<div class="dx-grid">
{% for i in (1..3) %}{% capture pid %}product_{{ i }}{% endcapture %}{% assign product = section.settings[pid] %}
{% if product != blank %}{% assign v = product.selected_or_first_available_variant %}
<article class="dx-card" style="--c:{% cycle '#f2cbd5','#f8dfd3','#ebc3d2' %}"><a href="{{ product.url }}" aria-label="{{ product.title | escape }}"><figure>{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="800" height="800">{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</figure></a>
<div class="dx-cb"><span class="dx-step">{{ section.settings.step_label | upcase }} {{ i }}</span><h3>{{ product.title }}</h3>{% if v.title != 'Default Title' %}<span class="dx-shade">{{ v.title }}</span>{% endif %}<span class="dx-price">{{ product.price | money }}</span>
{%- form 'product', product -%}<input type="hidden" name="id" value="{{ v.id }}">{% if product.available %}<button class="dx-btn" type="submit" style="width:100%">{{ section.settings.button_label }}</button>{% else %}<a class="dx-btn dx-ghost" href="{{ product.url }}">Sold out</a>{% endif %}{%- endform -%}</div></article>
{% endif %}{% endfor %}
</div>
{% if section.settings.note != blank %}<p class="dx-note">{{ section.settings.note }}</p>{% endif %}</div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name":"Dextor featured 3","tag":"section","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Featured"},
{"type":"text","id":"heading","label":"Heading","default":"The one-look routine"},
{"type":"text","id":"subheading","label":"Subheading","default":"Three products. One checkout. No fuss."},
{"type":"text","id":"step_label","label":"Step label","default":"Step"},
{"type":"text","id":"button_label","label":"Button label","default":"Add to Bag"},
{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},
{"type":"text","id":"note","label":"Small note (optional)"}],
"presets":[{"name":"Dextor featured 3"}]}
{% endschema %}
