{%- comment -%} Dextor: hero with arch product trio. Pick up to 3 products for the arches. {%- endcomment -%}
<section class="dx-home dx-hero" aria-labelledby="hh-{{ section.id }}"><div class="dx-wrap"><div>
{% if section.settings.eyebrow != blank %}<p class="dx-eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
<h1 id="hh-{{ section.id }}">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h1>
<p class="dx-lede">{{ section.settings.text }}</p>
{% if section.settings.button_label != blank %}<a class="dx-btn" href="{{ section.settings.button_link | default: '#routine' }}">{{ section.settings.button_label }}</a>{% endif %}</div>
<div class="dx-trio" aria-hidden="true">
{%- assign colors = section.settings.color_1 | append: ',' | append: section.settings.color_2 | append: ',' | append: section.settings.color_3 | split: ',' -%}
{% for i in (1..3) %}{% capture pid %}product_{{ i }}{% endcapture %}{% assign p = section.settings[pid] %}
{% if p != blank and p.featured_image %}<div class="dx-arch" style="--c:{{ colors[forloop.index0] }}"><img src="{{ p.featured_image | image_url: width: 800 }}" alt="" width="800" height="800"></div>{% else %}{% assign fb = 'stain.webp,oil.webp,blush.webp' | split: ',' %}<div class="dx-arch" style="--c:{{ colors[forloop.index0] }}"><img src="{{ fb[forloop.index0] | asset_url }}" alt="" width="800" height="800"></div>{% endif %}{% endfor %}
</div></div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name":"Dextor hero","tag":"section","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Vegan · cruelty-free · made in North America"},
{"type":"text","id":"heading","label":"Heading","default":"Beauty that"},
{"type":"text","id":"heading_accent","label":"Heading accent (italic, rose)","default":"gets you."},
{"type":"textarea","id":"text","label":"Text","default":"One look. Three products. Stain lays the color, oil glasses it over, blush brings it to your cheeks."},
{"type":"text","id":"button_label","label":"Button label","default":"Shop the routine"},
{"type":"url","id":"button_link","label":"Button link"},
{"type":"header","content":"Arch products (cut-out photos on white work best)"},
{"type":"product","id":"product_1","label":"Product 1"},{"type":"color","id":"color_1","label":"Arch 1","default":"#f2cbd5"},
{"type":"product","id":"product_2","label":"Product 2"},{"type":"color","id":"color_2","label":"Arch 2","default":"#f8dfd3"},
{"type":"product","id":"product_3","label":"Product 3"},{"type":"color","id":"color_3","label":"Arch 3","default":"#ebc3d2"}],
"presets":[{"name":"Dextor hero"}]}
{% endschema %}
