{%- comment -%} Hero: value proposition, primary + secondary CTA, reassurance line, arch trio from 3 product pickers (fallback to asset images). {%- endcomment -%}
<section class="dx-home dx-hero" aria-labelledby="hh-{{ section.id }}"><div class="dx-wrap"><div><p class="dx-eyebrow">{{ section.settings.eyebrow }}</p><h1 id="hh-{{ section.id }}">{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h1><p class="dx-lede">{{ section.settings.text }}</p>
<div class="dx-cta">{% if section.settings.button_label != blank %}<a class="dx-btn" href="{{ section.settings.button_link | default: '#routine' }}">{{ section.settings.button_label }}</a>{% endif %}{% if section.settings.button2_label != blank %}<a class="dx-btn dx-ghost" href="{{ section.settings.button2_link | default: '#how' }}">{{ section.settings.button2_label }}</a>{% endif %}</div>{% if section.settings.micro != blank %}<p class="dx-micro">{{ section.settings.micro }}</p>{% endif %}</div>
<div class="dx-trio" aria-hidden="true">{% assign fallback = 'stain.webp,oil.webp,blush.webp' | split: ',' %}{% assign cols = '#f2cbd5,#f8dfd3,#ebc3d2' | split: ',' %}{% for i in (1..3) %}{% capture pid %}product_{{ i }}{% endcapture %}{% assign p = section.settings[pid] %}{% assign ix = forloop.index0 %}<div class="dx-arch" style="--c:{{ cols[ix] }}">{% if p != blank and p.featured_image %}<img src="{{ p.featured_image | image_url: width: 800 }}" alt="" width="800" height="800">{% else %}<img src="{{ fallback[ix] | asset_url }}" alt="" width="800" height="800">{% endif %}</div>{% endfor %}</div></div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name": "Dextor hero", "tag": "section", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Vegan · cruelty-free · made in North America"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Beauty that"}, {"type": "text", "id": "heading_em", "label": "Heading (accent)", "default": "gets you."}, {"type": "textarea", "id": "text", "label": "Text", "default": "One look. Three products. Stain lays the color, oil glasses it over, blush brings it to your cheeks."}, {"type": "text", "id": "button_label", "label": "Primary button", "default": "Shop the routine"}, {"type": "url", "id": "button_link", "label": "Primary link (default #routine)"}, {"type": "text", "id": "button2_label", "label": "Secondary button", "default": "See how it works"}, {"type": "url", "id": "button2_link", "label": "Secondary link (default #how)"}, {"type": "text", "id": "micro", "label": "Reassurance line", "default": "Standard shipping $9.99, free over $50 · 30-day returns on unused products"}, {"type": "product", "id": "product_1", "label": "Hero product 1"}, {"type": "product", "id": "product_2", "label": "Hero product 2"}, {"type": "product", "id": "product_3", "label": "Hero product 3"}], "presets": [{"name": "Dextor hero"}]}
{% endschema %}
