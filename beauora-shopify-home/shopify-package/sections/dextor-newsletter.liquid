{%- comment -%} Newsletter (Shopify customer form). Offer text as shown on beauora.co. {%- endcomment -%}
<section class="dx-home dx-news" id="newsletter" aria-labelledby="nl-{{ section.id }}"><p class="dx-eyebrow">{{ section.settings.eyebrow }}</p><h2 id="nl-{{ section.id }}">{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p>
{% form 'customer', class: 'dx-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="ne-{{ section.id }}" style="position:absolute;left:-999px">Email address</label><input id="ne-{{ section.id }}" type="email" name="contact[email]" placeholder="Email address" required autocomplete="email" value="{{ form.email }}"><button type="submit">{{ section.settings.button_label }}</button>{% endform %}
<p class="dx-msg" role="status">{% if form.posted_successfully? %}{{ section.settings.success }}{% else %}{{ section.settings.fine }}{% endif %}</p></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name": "Dextor newsletter", "tag": "section", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Newsletter"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order"}, {"type": "text", "id": "text", "label": "Text", "default": "Join the list for early drops and subscriber-only codes."}, {"type": "text", "id": "button_label", "label": "Button", "default": "Join"}, {"type": "text", "id": "fine", "label": "Fine print", "default": "No spam, unsubscribe anytime."}, {"type": "text", "id": "success", "label": "Success message", "default": "Thanks for joining!"}], "presets": [{"name": "Dextor newsletter"}]}
{% endschema %}
