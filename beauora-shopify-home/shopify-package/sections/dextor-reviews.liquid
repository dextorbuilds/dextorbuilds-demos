{%- comment -%} DEMO REVIEWS. The sample reviews below are NOT real. Replace with real customer reviews or a reviews app. Each block shows its own star rating only (no aggregate). {%- endcomment -%}
<section class="dx-home dx-sec" id="reviews" aria-labelledby="rv-{{ section.id }}"><div class="dx-wrap">{% if section.settings.demo_label != blank %}<div class="dx-demo" role="note"><b>{{ section.settings.demo_label }}</b> {{ section.settings.demo_note }}</div>{% endif %}<p class="dx-eyebrow">{{ section.settings.eyebrow }}</p><h2 id="rv-{{ section.id }}">{{ section.settings.heading }}</h2>
<div class="dx-revs">{% for block in section.blocks %}<figure class="dx-rev" {{ block.shopify_attributes }}><span class="dx-stars" role="img" aria-label="{{ block.settings.stars }} out of 5 stars">{% for s in (1..block.settings.stars) %}★{% endfor %}{% assign rest = 5 | minus: block.settings.stars %}{% if rest > 0 %}<i>{% for s in (1..rest) %}★{% endfor %}</i>{% endif %}</span><blockquote>“{{ block.settings.text }}”</blockquote><figcaption>{{ block.settings.author }}{% if block.settings.tag != blank %} <span>{{ block.settings.tag }}</span>{% endif %}</figcaption></figure>{% endfor %}</div></div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name": "Dextor reviews (DEMO)", "tag": "section", "settings": [{"type": "paragraph", "content": "DEMO REVIEWS: the default reviews are sample text, not from real customers. Replace them with real customer reviews, then clear the demo label below."}, {"type": "text", "id": "demo_label", "label": "Demo label (clear when real)", "default": "Demo reviews, replace with real customer reviews."}, {"type": "text", "id": "demo_note", "label": "Demo note", "default": "Beauora’s site shows no reviews; these are sample text for layout only and are not from real customers."}, {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews"}, {"type": "text", "id": "heading", "label": "Heading", "default": "What customers could say here"}], "blocks": [{"type": "review", "name": "Review", "settings": [{"type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5}, {"type": "textarea", "id": "text", "label": "Review text", "default": "Review text"}, {"type": "text", "id": "author", "label": "Author (use the real name as shown)", "default": "Sample review"}, {"type": "text", "id": "tag", "label": "Tag", "default": "Demo"}]}], "max_blocks": 8, "presets": [{"name": "Dextor reviews (DEMO)", "blocks": [{"type": "review", "settings": {"stars": 5, "text": "Easy to use and quick to put on. Just what I wanted from a simple routine.", "author": "Sample review", "tag": "Demo"}}, {"type": "review", "settings": {"stars": 5, "text": "I like having only three products to think about. It keeps getting ready simple.", "author": "Sample review", "tag": "Demo"}}, {"type": "review", "settings": {"stars": 4, "text": "Pretty packaging and the shades are fun to pick. Nice little set.", "author": "Sample review", "tag": "Demo"}}, {"type": "review", "settings": {"stars": 5, "text": "The routine is easy to follow, and the steps are clearly laid out on the site.", "author": "Sample review", "tag": "Demo"}}]}]}
{% endschema %}
