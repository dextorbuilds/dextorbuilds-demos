{%- comment -%} Shipping and returns reassurance. Defaults from the store FAQ. {%- endcomment -%}
<section class="dx-home dx-sec" id="shipping" aria-labelledby="sh-{{ section.id }}"><div class="dx-wrap"><p class="dx-eyebrow">{{ section.settings.eyebrow }}</p><h2 id="sh-{{ section.id }}">{{ section.settings.heading }}</h2><div class="dx-ship">{% for block in section.blocks %}<div class="dx-sc" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p class="dx-big">{{ block.settings.big }}</p><p>{{ block.settings.text }}</p></div>{% endfor %}</div>{% if section.settings.note != blank %}<p class="dx-note">{{ section.settings.note }}</p>{% endif %}</div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name": "Dextor shipping & returns", "tag": "section", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shipping & returns"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Clear up front."}, {"type": "text", "id": "note", "label": "Note", "default": "Source: beauora.co FAQ. Confirm terms in your shipping and refund policies."}], "blocks": [{"type": "card", "name": "Card", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "Title"}, {"type": "text", "id": "big", "label": "Highlight", "default": "$0"}, {"type": "textarea", "id": "text", "label": "Text", "default": "Text"}]}], "max_blocks": 4, "presets": [{"name": "Dextor shipping & returns", "blocks": [{"type": "card", "settings": {"title": "Standard", "big": "$9.99", "text": "8-14 business days. Free over $50."}}, {"type": "card", "settings": {"title": "Express", "big": "$29.99", "text": "7-12 business days."}}, {"type": "card", "settings": {"title": "Returns", "big": "30 days", "text": "From delivery, for unused products. Email hello@beauora.co to start a return."}}]}]}
{% endschema %}
