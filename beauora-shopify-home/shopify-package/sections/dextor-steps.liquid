{%- comment -%} How it works: steps built from the real product steps. Photos: image picker, fallback to bundled representative stock. {%- endcomment -%}
<section class="dx-home dx-sec" id="how" aria-labelledby="hw-{{ section.id }}"><div class="dx-wrap"><p class="dx-eyebrow">{{ section.settings.eyebrow }}</p><h2 id="hw-{{ section.id }}">{{ section.settings.heading }}</h2><p class="dx-sub">{{ section.settings.subheading }}</p>
<ol class="dx-steps">{% for block in section.blocks %}<li class="dx-stp" {{ block.shopify_attributes }}><figure>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.product }}{% else %}<img src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy">{% endif %}{% if section.settings.stock_label != blank %}<figcaption>{{ section.settings.stock_label }}</figcaption>{% endif %}</figure><div><span class="dx-num">{{ forloop.index }}</span><h3>{{ block.settings.headline }}</h3><p class="dx-k">{{ block.settings.product }}</p><p>{{ block.settings.text }}</p></div></li>{% endfor %}</ol></div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name": "Dextor how it works", "tag": "section", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works"}, {"type": "text", "id": "heading", "label": "Heading", "default": "One look, in three steps."}, {"type": "text", "id": "subheading", "label": "Subheading", "default": "You shouldn’t need a 12-step routine to look good."}, {"type": "text", "id": "stock_label", "label": "Photo label (clear it when you use your own photos)", "default": "Representative stock photo (Pexels), not Beauora"}], "blocks": [{"type": "step", "name": "Step", "settings": [{"type": "image_picker", "id": "image", "label": "Photo"}, {"type": "select", "id": "fallback", "label": "Bundled fallback photo", "default": "look-lipstick.webp", "options": [{"value": "look-lipstick.webp", "label": "Lipstick"}, {"value": "look-gloss.webp", "label": "Gloss"}, {"value": "look-blush.webp", "label": "Blush"}]}, {"type": "text", "id": "headline", "label": "Headline", "default": "Step"}, {"type": "text", "id": "product", "label": "Product name", "default": "Product"}, {"type": "textarea", "id": "text", "label": "Text", "default": "Text"}]}], "max_blocks": 5, "presets": [{"name": "Dextor how it works", "blocks": [{"type": "step", "settings": {"fallback": "look-lipstick.webp", "headline": "Stain lays the color.", "product": "Matte Lip Stain", "text": "Designed to stay put through eating and drinking. Apply once in the morning."}}, {"type": "step", "settings": {"fallback": "look-gloss.webp", "headline": "Oil glasses it over.", "product": "Hydrating Lip Oil", "text": "Glass lips without the stick: a hydrating formula that gives shine without the tacky feeling."}}, {"type": "step", "settings": {"fallback": "look-blush.webp", "headline": "Blush brings it to your cheeks.", "product": "Liquid Blush", "text": "A flush that looks like you, not makeup."}}]}]}
{% endschema %}
