{%- comment -%} Trust strip: icon + text blocks (defaults = real store claims/policies). {%- endcomment -%}
<section class="dx-home dx-trust" aria-label="Why shop with us"><div class="dx-wrap">{% for block in section.blocks %}<div class="dx-t" {{ block.shopify_attributes }}>{% case block.settings.icon %}{% when 'vegan' %}<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 38C10 20 22 10 38 10c0 16-10 28-28 28z"/><path d="M10 38L28 20"/></svg>{% when 'cruel' %}<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 41S7 31 7 19a9 9 0 0 1 17-4 9 9 0 0 1 17 4c0 12-17 22-17 22z"/></svg>{% when 'na' %}<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="16"/><path d="M8 24h32M24 8c-7 8-7 24 0 32M24 8c7 8 7 24 0 32"/></svg>{% when 'ship' %}<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M5 14h24v18H5zM29 20h9l5 6v6H29z"/><circle cx="14" cy="34" r="3.5"/><circle cx="35" cy="34" r="3.5"/></svg>{% when 'ret' %}<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 20a15 15 0 1 1 3 14"/><path d="M10 11v9h9"/></svg>{% endcase %}<span>{{ block.settings.text }}</span></div>{% endfor %}</div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name": "Dextor trust strip", "tag": "section", "blocks": [{"type": "item", "name": "Item", "settings": [{"type": "select", "id": "icon", "label": "Icon", "default": "vegan", "options": [{"value": "vegan", "label": "vegan"}, {"value": "cruel", "label": "cruel"}, {"value": "na", "label": "na"}, {"value": "ship", "label": "ship"}, {"value": "ret", "label": "ret"}]}, {"type": "text", "id": "text", "label": "Text", "default": "Vegan"}]}], "max_blocks": 6, "presets": [{"name": "Dextor trust strip", "blocks": [{"type": "item", "settings": {"icon": "vegan", "text": "Vegan"}}, {"type": "item", "settings": {"icon": "cruel", "text": "Cruelty-free"}}, {"type": "item", "settings": {"icon": "na", "text": "Made in North America"}}, {"type": "item", "settings": {"icon": "ship", "text": "Free standard shipping over $50"}}, {"type": "item", "settings": {"icon": "ret", "text": "30-day returns on unused products"}}]}]}
{% endschema %}
