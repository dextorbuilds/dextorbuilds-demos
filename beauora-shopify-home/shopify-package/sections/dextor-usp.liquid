{%- comment -%} Dextor: benefits / USP row {%- endcomment -%}
<section class="dx-home dx-usp" aria-labelledby="uh-{{ section.id }}"><div class="dx-wrap"><h2 id="uh-{{ section.id }}" class="dx-eyebrow" style="grid-column:1/-1;padding-top:30px">{{ section.settings.heading }}</h2>
{% for block in section.blocks %}<div class="dx-u" {{ block.shopify_attributes }}>
{% case block.settings.icon %}
{% when 'stay' %}<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 6c6 8 11 14 11 21a11 11 0 0 1-22 0c0-7 5-13 11-21z"/><path d="M19 28a5 5 0 0 0 5 5"/></svg>
{% when 'gloss' %}<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 5l3.5 10.5L38 19l-10.5 3.5L24 33l-3.5-10.5L10 19l10.5-3.5z"/><path d="M37 32l1.5 4.5L43 38l-4.5 1.5L37 44l-1.5-4.5L31 38l4.5-1.5z"/></svg>
{% else %}<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="6"/><path d="M24 6c3 5 3 9 0 12M24 42c-3-5-3-9 0-12M6 24c5-3 9-3 12 0M42 24c-5 3-9 3-12 0M11 11c5 1 8 3 9 7M37 37c-5-1-8-3-9-7M37 11c-1 5-3 8-7 9M11 37c1-5 3-8 7-9"/></svg>
{% endcase %}
<div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div></div>{% endfor %}</div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name":"Dextor benefits","tag":"section","settings":[{"type":"text","id":"heading","label":"Heading","default":"Why beauora? Three products. No filler. Just results."}],
"blocks":[{"type":"usp","name":"Benefit","settings":[
{"type":"select","id":"icon","label":"Icon","options":[{"value":"stay","label":"Drop"},{"value":"gloss","label":"Sparkle"},{"value":"flush","label":"Bloom"}],"default":"stay"},
{"type":"text","id":"heading","label":"Heading","default":"Benefit"},{"type":"textarea","id":"text","label":"Text","default":"Short description."}]}],
"max_blocks":6,
"presets":[{"name":"Dextor benefits","blocks":[{"type":"usp","settings":{"icon":"stay","heading":"Stain that stays","text":"One swipe, stays all day."}},{"type":"usp","settings":{"icon":"gloss","heading":"Gloss without the stick","text":"Glass shine that hydrates, never sticky."}},{"type":"usp","settings":{"icon":"flush","heading":"Blush that looks like you","text":"A natural flush that looks like you."}}]}]}
{% endschema %}
