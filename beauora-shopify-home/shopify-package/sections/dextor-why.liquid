{%- comment -%} Why choose us: checklist of real facts + 3 USP blocks. {%- endcomment -%}
<section class="dx-home dx-sec" aria-labelledby="wy-{{ section.id }}"><div class="dx-wrap dx-why"><div><p class="dx-eyebrow">{{ section.settings.eyebrow }}</p><h2 id="wy-{{ section.id }}">{{ section.settings.heading }}</h2><ul class="dx-checks">{% for block in section.blocks %}{% if block.type == 'check' %}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{% endif %}{% endfor %}</ul></div><div class="dx-usp3">{% for block in section.blocks %}{% if block.type == 'usp' %}<div class="dx-u" {{ block.shopify_attributes }}><div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div></div>{% endif %}{% endfor %}</div></div></section>
{{ 'dextor-home.css' | asset_url | stylesheet_tag }}
{% schema %}
{"name": "Dextor why choose us", "tag": "section", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why beauora?"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Three products. No filler. Just results."}], "blocks": [{"type": "check", "name": "Checklist item", "settings": [{"type": "text", "id": "text", "label": "Text", "default": "Item"}]}, {"type": "usp", "name": "Feature card", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Heading"}, {"type": "text", "id": "text", "label": "Text", "default": "Text"}]}], "presets": [{"name": "Dextor why choose us", "blocks": [{"type": "check", "settings": {"text": "Vegan, cruelty-free makeup (the store’s claim)"}}, {"type": "check", "settings": {"text": "Made in North America (the store’s claim)"}}, {"type": "check", "settings": {"text": "Three products. One look. Done."}}, {"type": "check", "settings": {"text": "No fillers. No fluff. Just products that do what they say."}}, {"type": "check", "settings": {"text": "Free standard shipping over $50"}}, {"type": "check", "settings": {"text": "30-day returns on unused products"}}, {"type": "usp", "settings": {"heading": "Stain that stays", "text": "One swipe, stays all day."}}, {"type": "usp", "settings": {"heading": "Gloss without the stick", "text": "Glass shine that hydrates, never sticky."}}, {"type": "usp", "settings": {"heading": "Blush that looks like you", "text": "A natural flush that looks like you."}}]}]}
{% endschema %}
